    <script src="plugins/server/cpanel/assets/panels.js?v=<?php echo (int) filemtime(__DIR__ . '/../assets/panels.js'); ?>"></script>
    <script>
        (function () {
            var panel = CpanelPanel.create(<?php echo (int) $this->userPackageId; ?>, 'panelFtp');

            $(document).ready(function () {
                panel.table('#cpanel-ftp-list', clientexec.lang('No FTP accounts to show'), clientexec.lang('No matching FTP accounts found'));
            });

            // Delegated handlers so buttons keep working across DataTables paging and filtering
            $('#cpanel-ftp-list').on('click', '.cpanel-ftp-edit', function () {
                var login = $(this).data('login');
                $('#cpanel-ftp-edit-title').text(login);
                $('#cpanel-ftp-edit-login').val(login);
                $('#cpanel-ftp-edit-password').val('');
                $('#cpanel-ftp-edit-quota').val('');
                $('#cpanel-ftp-edit-modal').modal('show');
            });

            $('#cpanel-ftp-list').on('click', '.cpanel-ftp-delete', function () {
                panel.confirmAction(
                    clientexec.lang('Delete FTP Account'),
                    clientexec.lang('Are you sure you want to delete this FTP account? The files in its directory will not be removed.'),
                    clientexec.lang('Delete'),
                    'deleteFtp',
                    { login: $(this).data('login') }
                );
            });

            $('#cpanel-ftp-create-submit').on('click', function () {
                var data = {
                    user: $.trim($('#cpanel-ftp-user').val()),
                    domain: $('#cpanel-ftp-domain').val(),
                    password: $('#cpanel-ftp-password').val(),
                    homedir: $.trim($('#cpanel-ftp-homedir').val()),
                    quota: $.trim($('#cpanel-ftp-quota').val())
                };
                if (data.user === '' || data.password === '') {
                    return;
                }
                $('#cpanel-ftp-create-modal').modal('hide');
                panel.reloadAction('createFtp', data);
            });

            $('#cpanel-ftp-edit-submit').on('click', function () {
                var data = {
                    login: $('#cpanel-ftp-edit-login').val(),
                    password: $('#cpanel-ftp-edit-password').val(),
                    quota: $.trim($('#cpanel-ftp-edit-quota').val())
                };
                if (data.password === '' && data.quota === '') {
                    return;
                }
                $('#cpanel-ftp-edit-modal').modal('hide');
                panel.reloadAction('updateFtp', data);
            });
        })();
    </script>
<?php } ?>