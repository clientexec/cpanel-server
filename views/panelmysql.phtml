    <script src="plugins/server/cpanel/assets/panels.js?v=<?php echo (int) filemtime(__DIR__ . '/../assets/panels.js'); ?>"></script>
    <script>
        (function () {
            var panel = CpanelPanel.create(<?php echo (int) $this->userPackageId; ?>, 'panelMysql');

            $(document).ready(function () {
                panel.table('#cpanel-mysql-db-list', clientexec.lang('No databases to show'), clientexec.lang('No matching databases found'));
                panel.table('#cpanel-mysql-user-list', clientexec.lang('No database users to show'), clientexec.lang('No matching database users found'));
            });

            // Delegated handlers so buttons keep working across DataTables paging and filtering
            $('#cpanel-mysql-db-list').on('click', '.cpanel-mysql-db-delete', function () {
                panel.confirmAction(
                    clientexec.lang('Delete Database'),
                    clientexec.lang('Are you sure you want to delete this database? All of its data will be permanently removed.'),
                    clientexec.lang('Delete'),
                    'deleteDatabase',
                    { database: $(this).data('database') }
                );
            });

            $('#cpanel-mysql-db-list').on('click', '.cpanel-mysql-revoke', function () {
                panel.confirmAction(
                    clientexec.lang('Remove User from Database'),
                    clientexec.lang('Are you sure you want to remove database access for this user?'),
                    clientexec.lang('Remove'),
                    'revokeDbAccess',
                    { database: $(this).data('database'), user: $(this).data('user') }
                );
            });

            $('#cpanel-mysql-user-list').on('click', '.cpanel-mysql-user-delete', function () {
                panel.confirmAction(
                    clientexec.lang('Delete Database User'),
                    clientexec.lang('Are you sure you want to delete this database user? Anything using it to connect will stop working.'),
                    clientexec.lang('Delete'),
                    'deleteDbUser',
                    { user: $(this).data('user') }
                );
            });

            $('#cpanel-mysql-user-list').on('click', '.cpanel-mysql-user-password', function () {
                var user = $(this).data('user');
                $('#cpanel-mysql-password-title').text(user);
                $('#cpanel-mysql-password-user').val(user);
                $('#cpanel-mysql-password-value').val('');
                $('#cpanel-mysql-password-modal').modal('show');
            });

            $('#cpanel-mysql-db-create-submit').on('click', function () {
                var name = $.trim($('#cpanel-mysql-db-name').val());
                if (name === '') {
                    return;
                }
                $('#cpanel-mysql-db-create-modal').modal('hide');
                panel.reloadAction('createDatabase', { name: name });
            });

            $('#cpanel-mysql-user-create-submit').on('click', function () {
                var data = {
                    name: $.trim($('#cpanel-mysql-user-name').val()),
                    password: $('#cpanel-mysql-user-password').val()
                };
                if (data.name === '' || data.password === '') {
                    return;
                }
                $('#cpanel-mysql-user-create-modal').modal('hide');
                panel.reloadAction('createDbUser', data);
            });

            $('#cpanel-mysql-grant-submit').on('click', function () {
                var data = {
                    user: $('#cpanel-mysql-grant-user').val(),
                    database: $('#cpanel-mysql-grant-database').val()
                };
                $('#cpanel-mysql-grant-modal').modal('hide');
                panel.reloadAction('grantDbAccess', data);
            });

            $('#cpanel-mysql-password-submit').on('click', function () {
                var data = {
                    user: $('#cpanel-mysql-password-user').val(),
                    password: $('#cpanel-mysql-password-value').val()
                };
                if (data.password === '') {
                    return;
                }
                $('#cpanel-mysql-password-modal').modal('hide');
                panel.reloadAction('updateDbUserPassword', data);
            });
        })();
    </script>
<?php } ?>