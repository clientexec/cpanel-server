<?php if ($this->loadError != '') { ?>
    <div class="alert alert-danger"><?php echo $this->loadError; ?></div>
<?php } else { ?>
    <button type="button" class="btn btn-success mb-2" data-toggle="modal" data-target="#cpanel-forwarder-create-modal">
        <?php echo $this->user->lang('Create Forwarder'); ?>
    </button>
    <div class="data-table-wrapper">
        <div class="table-responsive">
            <table class="table" id="cpanel-forwarder-list">
                <thead>
                <tr>
                    <th><?php echo $this->user->lang('Address'); ?></th>
                    <th><?php echo $this->user->lang('Forwards To'); ?></th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($this->forwarders as $forwarder) { ?>
                    <tr>
                        <td><?php echo $this->escape($forwarder['address']); ?></td>
                        <td><?php echo $this->escape($forwarder['destination']); ?></td>
                        <td class="text-right text-nowrap">
                            <button type="button" class="btn btn-sm btn-danger cpanel-forwarder-delete"
                                    data-address="<?php echo $this->escape($forwarder['address']); ?>"
                                    data-destination="<?php echo $this->escape($forwarder['destination']); ?>">
                                <?php echo $this->user->lang('Delete'); ?>
                            </button>
                        </td>
                    </tr>
                <?php } ?>
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal" tabindex="-1" role="dialog" id="cpanel-forwarder-create-modal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><?php echo $this->user->lang('Create Forwarder'); ?></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="<?php echo $this->user->lang('Close'); ?>">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="cpanel-forwarder-user"><?php echo $this->user->lang('Address to Forward'); ?></label>
                        <div class="input-group">
                            <input type="text" id="cpanel-forwarder-user" class="form-control" autocomplete="off" />
                            <div class="input-group-append"><span class="input-group-text">@</span></div>
                            <select id="cpanel-forwarder-domain" class="form-control">
                                <?php foreach ($this->domains as $domain) { ?>
                                    <option value="<?php echo $this->escape($domain); ?>"><?php echo $this->escape($domain); ?></option>
                                <?php } ?>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="cpanel-forwarder-destination"><?php echo $this->user->lang('Forward To'); ?></label>
                        <input type="email" id="cpanel-forwarder-destination" class="form-control" autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="cpanel-forwarder-create-submit"><?php echo $this->user->lang('Create'); ?></button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><?php echo $this->user->lang('Close'); ?></button>
                </div>
            </div>
        </div>
    </div>

    <script src="plugins/server/cpanel/assets/panels.js?v=<?php echo (int) filemtime(__DIR__ . '/../assets/panels.js'); ?>"></script>
    <script>
        (function () {
            var panel = CpanelPanel.create(<?php echo (int) $this->userPackageId; ?>, 'panelForwarders');

            $(document).ready(function () {
                panel.table('#cpanel-forwarder-list', clientexec.lang('No email forwarders to show'), clientexec.lang('No matching email forwarders found'));
            });

            // Delegated handler so buttons keep working across DataTables paging and filtering
            $('#cpanel-forwarder-list').on('click', '.cpanel-forwarder-delete', function () {
                panel.confirmAction(
                    clientexec.lang('Delete Forwarder'),
                    clientexec.lang('Are you sure you want to delete this forwarder?'),
                    clientexec.lang('Delete'),
                    'deleteForwarder',
                    { address: $(this).data('address'), destination: $(this).data('destination') }
                );
            });

            $('#cpanel-forwarder-create-submit').on('click', function () {
                var data = {
                    user: $.trim($('#cpanel-forwarder-user').val()),
                    domain: $('#cpanel-forwarder-domain').val(),
                    destination: $.trim($('#cpanel-forwarder-destination').val())
                };
                if (data.user === '' || data.destination === '') {
                    return;
                }
                $('#cpanel-forwarder-create-modal').modal('hide');
                panel.reloadAction('createForwarder', data);
            });
        })();
    </script>
<?php } ?>