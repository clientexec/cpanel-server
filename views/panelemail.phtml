    <script src="plugins/server/cpanel/assets/panels.js?v=<?php echo (int) filemtime(__DIR__ . '/../assets/panels.js'); ?>"></script>
    <script>
        (function () {
            var panel = CpanelPanel.create(<?php echo (int) $this->userPackageId; ?>, 'panelEmail');

            $(document).ready(function () {
                panel.table('#cpanel-email-list', clientexec.lang('No email accounts to show'), clientexec.lang('No matching email accounts found'));
            });

            // Delegated handlers so buttons keep working across DataTables paging and filtering
            $('#cpanel-email-list').on('click', '.cpanel-email-login', function () {
                panel.openUrlAction('emailLogin', { email: $(this).data('email') });
            });

            $('#cpanel-email-list').on('click', '.cpanel-email-edit', function () {
                var email = $(this).data('email');
                $('#cpanel-email-edit-title').text(email);
                $('#cpanel-email-edit-address').val(email);
                $('#cpanel-email-edit-password').val('');
                $('#cpanel-email-edit-quota').val('');
                $('#cpanel-email-edit-modal').modal('show');
            });

            $('#cpanel-email-list').on('click', '.cpanel-email-delete', function () {
                panel.confirmAction(
                    clientexec.lang('Delete Email Account'),
                    clientexec.lang('Are you sure you want to delete this email account? All of its mail will be permanently removed.'),
                    clientexec.lang('Delete'),
                    'deleteEmail',
                    { email: $(this).data('email') }
                );
            });

            $('#cpanel-email-create-submit').on('click', function () {
                var data = {
                    user: $.trim($('#cpanel-email-user').val()),
                    domain: $('#cpanel-email-domain').val(),
                    password: $('#cpanel-email-password').val(),
                    quota: $.trim($('#cpanel-email-quota').val())
                };
                if (data.user === '' || data.password === '') {
                    return;
                }
                $('#cpanel-email-create-modal').modal('hide');
                panel.reloadAction('createEmail', data);
            });

            $('#cpanel-email-edit-submit').on('click', function () {
                var data = {
                    email: $('#cpanel-email-edit-address').val(),
                    password: $('#cpanel-email-edit-password').val(),
                    quota: $.trim($('#cpanel-email-edit-quota').val())
                };
                if (data.password === '' && data.quota === '') {
                    return;
                }
                $('#cpanel-email-edit-modal').modal('hide');
                panel.reloadAction('updateEmail', data);
            });
        })();
    </script>
<?php } ?>